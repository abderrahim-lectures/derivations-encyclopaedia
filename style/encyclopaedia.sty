\newcommand{\hbtitle}{Encyclopaedia of Derivations}
% The cover prints the title as two lines; this is the second of them.
% Keeping it beside \hbtitle means a rename is one edit, not three.
\newcommand{\hbwordone}{Encyclopaedia}
\newcommand{\hbtitleshort}{of Derivations}
\newcommand{\hbsubtitle}{Origins and Development, with Applications and Worked Examples}
\newcommand{\hbauthor}{Abderrahim Adrabi}
\newcommand{\hbaffil}{Faculty of Sciences and Faculty of Educational Sciences,\\
  Mohammed V University in Rabat, Morocco}
\newcommand{\hbversion}{v0.18}
\newcommand{\hbedition}{Living edition, updated monthly}

% ---- translations (owner rule, 2026-10-02: state every translation) --------
% Owner rule, 2026-10-03: the original comes first, quoted, then the
% translation.
% \translated{<our English>}{<original wording>}{<language>}
%   inline: ``original'' (Language; our translation: ``English'').
% \begin{originalquote}{<language>}{<original paragraph>} <our English> \end{originalquote}
%   display: the original paragraph quoted in italics, then our translation.
% Every paraphrase of a source not in English carries at least one
% originalquote or \translated with the sentence it rests on.
\newcommand{\translated}[3]{``\emph{#2}'' (#3; our translation: ``#1'')}
\newenvironment{originalquote}[2]
  {\begin{quote}\small``\emph{#2}''\par\smallskip\noindent Our translation
   from #1: ``\ignorespaces}
  {\unskip''\end{quote}}
% \translatedtitle{<language>} after a citation of a work whose title the text
% gives in English although the work is in another language.
\newcommand{\translatedtitle}[1]{\footnote{Title translated from #1.}}
